{
  "name": "contract-guard",
  "version": "1.0.0",
  "description": "API contract registry: version specs, detect breaking changes, track affected consumers, block dangerous publishes.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/engine.test.js test/policy.test.js test/pipeline.test.js",
    "test:engine": "node --test test/engine.test.js",
    "test:policy": "node --test test/policy.test.js",
    "test:pipeline": "node --test test/pipeline.test.js",
    "test:api": "node --test test/api.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:all": "node --test test/"
  },
  "dependencies": {
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
